# Copy to .env.local for local development. Never commit real values.

# --- Supabase (local dev values come from `npx supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by background jobs (briefings, notifications) and admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the app (used for auth redirects and push deep links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show the "Continue with Google" button (Google provider must be enabled in Supabase)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- AI providers (server only) ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model roles (override without code changes)
NAVI_MODEL_FAST=claude-haiku-5-5
NAVI_MODEL_PLANNER=claude-sonnet-5-5
NAVI_MODEL_VOICE=gemini-3.8-live
# Fallback model when the planner model is unavailable
NAVI_MODEL_PLANNER_FALLBACK=claude-haiku-5-5
# Server-side refusal fallbacks on the Claude API for Sonnet ("default" or "off")
NAVI_REFUSAL_FALLBACKS=default
# "anthropic" (real) or "devsim" (deterministic simulator, development/test only; refused in production)
NAVI_AI_PROVIDER=anthropic

# --- $2/day AI testing guard ---
NAVI_DAILY_BUDGET_USD=2
NAVI_BUDGET_WARN_RATIO=0.75
# Budget day boundary (IANA zone). Resets at local midnight here.
NAVI_BUDGET_TIMEZONE=UTC
# Accounts allowed to raise the shared daily budget (comma-separated). Empty in production = nobody.
NAVI_ADMIN_EMAILS=

# --- Background jobs ---
# Shared secret for /api/cron/tick (Vercel Cron / Trigger.dev)
CRON_SECRET=

# --- Web push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
