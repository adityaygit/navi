# Copy to .env.local for local development. Never commit real values.

# --- Supabase (local dev values come from `npx supabase status`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by background jobs (briefings, notifications) and admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the app (used for auth redirects and push deep links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Show the "Continue with Google" button (Google provider must be enabled in Supabase)
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- AI providers (server only) ---
ANTHROPIC_API_KEY=
# Same key under another name, for Claude Code cloud environments (they reserve ANTHROPIC_API_KEY)
# NAVI_ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Model roles (override without code changes)
NAVI_MODEL_FAST=claude-haiku-5-5
NAVI_MODEL_PLANNER=claude-sonnet-5-5
NAVI_MODEL_VOICE=gemini-3.8-live
# Fallback model when the planner model is unavailable
NAVI_MODEL_PLANNER_FALLBACK=claude-haiku-5-5
# Server-side refusal fallbacks on the Claude API for Sonnet ("default" or "off")
NAVI_REFUSAL_FALLBACKS=default
# "anthropic" (real) or "devsim" (deterministic simulator, development/test only; refused in production)
NAVI_AI_PROVIDER=anthropic

# --- $2/day AI testing guard ---
NAVI_DAILY_BUDGET_USD=2
NAVI_BUDGET_WARN_RATIO=0.75
# Budget day boundary (IANA zone). Resets at local midnight here.
NAVI_BUDGET_TIMEZONE=UTC
# Accounts allowed to raise the shared daily budget (comma-separated). Empty in production = nobody.
NAVI_ADMIN_EMAILS=

# --- Background jobs ---
# Shared secret for /api/cron/tick (Vercel Cron / Trigger.dev)
CRON_SECRET=

# --- Setup only: read by Claude Code / CLI when configuring services, never by the app ---
# Trigger.dev (10-minute scheduler, trigger/tick.ts). Deploy: npx trigger.dev@latest deploy
# Personal access token (tr_pat_…): Trigger.dev → Account → Personal Access Tokens
TRIGGER_ACCESS_TOKEN=
# Project ref (proj_…): Trigger.dev → Project settings. Read by trigger.config.ts
TRIGGER_PROJECT_REF=
# Production secret key (tr_prod_…): Trigger.dev → API Keys → Production
TRIGGER_SECRET_KEY=
# Google sign-in: OAuth client (Web application) from Google Cloud → APIs & Services → Credentials,
# redirect URI https://<supabase-ref>.supabase.co/auth/v1/callback. Copied into Supabase Auth → Google.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Linear integration (server only; read-only import of assigned issues) ---
# OAuth app at Linear → Settings → API → OAuth applications. Callback URL registered there must
# exactly equal LINEAR_REDIRECT_URL (default: <NEXT_PUBLIC_SITE_URL>/api/integrations/linear/callback).
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URL=
# Encrypts stored OAuth tokens (AES-256-GCM). 32 random bytes: openssl rand -base64 32
# Never change it casually: existing connections can't be decrypted with a new key (they must reconnect).
NAVI_TOKEN_ENCRYPTION_KEY=
# Optional, for future real-time sync: the signing secret of the Linear app's webhook.
LINEAR_WEBHOOK_SECRET=

# --- Web push (generate with: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

# --- Email (waitlist) — Resend. Without a key, dev logs emails; production refuses to send. ---
RESEND_API_KEY=
# e.g. Navi <hello@mail.yourdomain.com> (domain must be verified in Resend)
EMAIL_FROM=
# Optional: where replies go (e.g. your own inbox)
EMAIL_REPLY_TO=
